NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here

# Service role key (Project Settings > API no painel do Supabase).
# Usada SÓ server-side (import, metas, admin) — nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Contas de teste (Manager/Supervisor/Vendedor) já existentes no banco, usadas só por
# scripts/security_audit_scope_forgery.mjs. Nunca commitar valor real — só os nomes aqui.
TEST_MANAGER_EMAIL=
TEST_MANAGER_PASSWORD=
TEST_SUPERVISOR_EMAIL=
TEST_SUPERVISOR_PASSWORD=
TEST_VENDEDOR_EMAIL=
TEST_VENDEDOR_PASSWORD=

# Chave da API do Gemini (Google AI Studio), usada SÓ server-side pelo módulo
# /assistente (src/lib/assistente/gemini.ts) — nunca prefixar com NEXT_PUBLIC_.
GEMINI_API_KEY=

# Opcional: sobrescreve o modelo Gemini usado pelo /assistente sem precisar
# alterar código. Default no código: gemini-3.6-flash.
GEMINI_MODEL=
